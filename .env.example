LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Fallback model: used when the primary would wait >5 s for its token budget or is rate-limited
# (separate provider rate limit). Evaluated 7/7 tool choice, 0 grounding failures:
# docs/eval/eval_results_gpt-oss-20b.md. Leave empty to disable.
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
