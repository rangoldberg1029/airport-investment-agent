# Copy this file to .env and fill in your keys. Never commit .env (it is in .gitignore).
# Both providers have free tiers; no credit card is needed.

# --- Required -------------------------------------------------------------------------------
# Google AI Studio key for the language model (Gemini). Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional -------------------------------------------------------------------------------
# Gemini model name (default: gemini-3.5-flash-lite).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Groq key: enables voice input (Whisper) and automatic failover to Groq when Gemini is rate-limited,
# returns a server error or times out. Create one at https://console.groq.com/keys
# Without it, everything except voice input works, without failover.
# If only GROQ_API_KEY is set, the app runs on Groq alone.
GROQ_API_KEY=

# Groq model name for failover (default: openai/gpt-oss-120b).
# GROQ_MODEL=openai/gpt-oss-120b
