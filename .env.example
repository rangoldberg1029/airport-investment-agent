# Primary LLM: Google Gemini Flash-Lite (free tier, no card) via its OpenAI-compatible endpoint.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Lowest thinking level (Gemini 3: minimal | low | medium | high).
LLM_REASONING_EFFORT=minimal
# Optional: GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Fallback LLM (the only one): Groq free tier. Used when Gemini is rate-limited or out of daily quota.
# Key: https://console.groq.com/keys  (also used for voice transcription, Whisper on Groq)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_MODEL=openai/gpt-oss-120b

# Without GEMINI_API_KEY, Groq (LLM_FALLBACK_MODEL) is the only provider.
