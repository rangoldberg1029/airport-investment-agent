# Streamlit secrets for a deployment (e.g. Streamlit Community Cloud): paste these keys into the app's
# Secrets settings, or copy this file to .streamlit/secrets.toml locally. Never commit secrets.toml
# (it is in .gitignore). Same keys as .env.example.

# Required: Google AI Studio key for the language model (Gemini). https://aistudio.google.com/apikey
GEMINI_API_KEY = ""

# Optional: Gemini model name (default: gemini-3.5-flash-lite).
# GEMINI_MODEL = "gemini-3.5-flash-lite"

# Optional: Groq key for voice input (Whisper) and automatic failover to Groq. https://console.groq.com/keys
# If only GROQ_API_KEY is set, the app runs on Groq alone.
GROQ_API_KEY = ""

# Optional: Groq model name for failover (default: openai/gpt-oss-120b).
# GROQ_MODEL = "openai/gpt-oss-120b"
